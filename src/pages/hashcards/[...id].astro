---
import { marked } from 'marked';
import { getCollection } from 'astro:content';
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const hashcards = await getCollection('hashcards');

  return hashcards.map(deck => ({
    params: { id: deck.id },
    props: { deck },
  }));
}

const { deck } = Astro.props;

const title = deck.id

const parsedCards = deck.data.cards.map(card =>
  ({
      question: marked.parse(card.question),
      answer: marked.parse(card.answer),
    })
);
---

<script
  type="application/json"
  id="deck-data"
  set:html={JSON.stringify(parsedCards)}
>
</script>

<script>
  import DOMPurify from 'dompurify';

  const dataElement = document.getElementById('deck-data');
  const cards = JSON.parse(dataElement.textContent);

  const question = document.getElementById('question');
  const answer = document.getElementById('answer');

  const STATE_SHOWING_QUESTION = 1
  const STATE_SHOWING_ANSWER = 2

  var currentCard = null;
  var currentState = null;

  function updateCard() {
    const idx = Math.floor(Math.random() * cards.length);
    currentCard = cards[idx];
  }

  function updateContent() {
    if (currentState == STATE_SHOWING_QUESTION) {
      const html = currentCard['answer'];
      const clean = DOMPurify.sanitize(html);
      document.getElementById('answer').innerHTML = clean;
      currentState = STATE_SHOWING_ANSWER;
    } else {
      document.getElementById('question').innerHTML = "";
      document.getElementById('answer').innerHTML = "";
      updateCard()
      const html = currentCard['question'];
      const clean = DOMPurify.sanitize(html);
      document.getElementById('question').innerHTML = clean;
      currentState = STATE_SHOWING_QUESTION;
    }
  }

  // Initialize
  updateContent()

  document.getElementById("container").addEventListener("click", updateContent);
  document.getElementById("nextButton").addEventListener("click", (event) => {
    event.stopPropagation();
    updateContent();
  });

  </script>

<BaseLayout title={title}>
  <div id="container" class="min-h-screen">

    <section class="max-w-2xl mx-auto">

      <div class="prose">
        <div id="question"></div>
        Large pb to offset fixed-position "Next" button bottom of screen
        <div id="answer" class="mt-5 pb-32"></div>
      </div>

      <div class="fixed bottom-0 mx-auto left-0 right-0 w-full px-8 py-6 bg-white/70">
        <button id="nextButton" type="button" class="block mx-auto px-5 py-3 border border-gray-300 rounded-md hover:bg-gray-50">
          Next
        </button>
      </div>

    </section>
  
  </div>
</BaseLayout>
