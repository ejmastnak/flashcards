---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { path2slug, path2id } from "@/lib/flashcards.js";

export function getStaticPaths() {

  const decks = import.meta.glob("../../content/flashcards/**/*.ts", {
    eager: true,
  });

  return Object.keys(decks).map((path) => {
    const slug = path2slug(path);

    return {
      params: { slug: slug },
      props: { path: path },
    };
  });
}

interface Props {
  path: string
}
const { path } = Astro.props as Props;

const title = path2id(path);
---

<script
  type="application/json"
  id="module-path"
  set:html={JSON.stringify(path)}
>
</script>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';

  const modules = import.meta.glob("../../content/flashcards/**/*.ts");
  const dataElement = document.getElementById('module-path');
  const path = JSON.parse(dataElement.textContent);
  console.log(dataElement.textContent);
  const module = await modules[path]()

  const question = document.getElementById('question');
  const answer = document.getElementById('answer');

  const STATE_SHOWING_QUESTION = 1
  const STATE_SHOWING_ANSWER = 2

  var currentCard = null;
  var currentState = null;

  function updateCard() {
    currentCard = module.generate();
  }

  function updateContent() {
    if (currentState == STATE_SHOWING_QUESTION) {
      const html = marked.parse(currentCard['answer']);
      const clean = DOMPurify.sanitize(html);
      document.getElementById('answer').innerHTML = clean;
      currentState = STATE_SHOWING_ANSWER;
    } else {
      document.getElementById('question').innerHTML = "";
      document.getElementById('answer').innerHTML = "";
      updateCard()
      const html = marked.parse(currentCard['question']);
      const clean = DOMPurify.sanitize(html);
      document.getElementById('question').innerHTML = clean;
      currentState = STATE_SHOWING_QUESTION;
    }
  }

  // Initialize
  updateContent()

  document.getElementById("container").addEventListener("click", updateContent);
  document.getElementById("nextButton").addEventListener("click", (event) => {
    event.stopPropagation();
    updateContent();
  });


</script>

<BaseLayout title={title}>
  <div id="container">

    <section class="max-w-2xl mx-auto">

      <div class="h-[50vh] prose">
        <div id="question"></div>
        <div id="answer" class="mt-5"></div>
      </div>

      <div class="mt-5 pt-5 border-t border-gray-200 mx-auto">
        <button id="nextButton" type="button" class="block mx-auto px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-50">
          Next
        </button>
      </div>

    </section>

  </div>
</BaseLayout>
